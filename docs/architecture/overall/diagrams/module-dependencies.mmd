    classDef core       fill:#dbeafe,stroke:#2563eb,color:#1e3a5f,font-weight:bold
    classDef pricing    fill:#fef3c7,stroke:#d97706,color:#451a03,font-weight:bold
    classDef fulfil     fill:#dcfce7,stroke:#16a34a,color:#14532d,font-weight:bold
    classDef identity   fill:#f3e8ff,stroke:#9333ea,color:#2e1065,font-weight:bold
    classDef infra      fill:#f1f5f9,stroke:#64748b,color:#0f172a
    classDef note       fill:#fafafa,stroke:#d1d5db,color:#6b7280,font-style:italic

    class Cart,Order,Payment,Product,Customer core
    class Pricing,Promotion,Region,Currency pricing
    class Fulfillment,Inventory,StockLocation fulfil
    class Auth,User,SalesChannel identity
    class Notification,FileModule,WorkflowStore infra
    class PaymentNote note
