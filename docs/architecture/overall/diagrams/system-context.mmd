  System_Ext(s3, "S3 / File Storage", "Object storage (AWS S3, MinIO, or compatible). Stores product images and uploaded assets.")
  System_Ext(postgres, "PostgreSQL 15", "Primary relational database. Stores all commerce data via MikroORM.")
  System_Ext(redis, "Redis", "Dual-purpose: in-memory cache layer and event-bus transport for async domain events.")

