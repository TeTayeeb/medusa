classDiagram
    direction TB

    class Customer {
        +String id
        +String company_name
        +String first_name
        +String last_name
        +String email
        +String phone
        +Boolean has_account
        +JSON metadata
        +String created_by
        +Date created_at
        +Date updated_at
        +Date deleted_at
    }

    class CustomerGroup {
        +String id
        +String name
        +JSON metadata
        +String created_by
        +Date created_at
        +Date updated_at
        +Date deleted_at
    }

    class CustomerGroupCustomer {
        +String id
        +String customer_id
        +String customer_group_id
        +Date created_at
        +Date updated_at
        +Date deleted_at
    }

    class CustomerAddress {
        +String id
        +String address_name
        +Boolean is_default_shipping
        +Boolean is_default_billing
        +String company
        +String first_name
        +String last_name
        +String address_1
        +String address_2
        +String city
        +String country_code
        +String province
        +String postal_code
        +String phone
        +JSON metadata
        +String customer_id
        +Date created_at
        +Date updated_at
        +Date deleted_at
    }

    class CustomerModuleService {
        +createCustomers(data) CustomerDTO
        +updateCustomers(id, data) CustomerDTO
        +deleteCustomers(ids) void
        +listCustomers(filters, config) CustomerDTO[]
        +retrieveCustomer(id, config) CustomerDTO
        +createCustomerGroups(data) CustomerGroupDTO
        +updateCustomerGroups(id, data) CustomerGroupDTO
        +deleteCustomerGroups(ids) void
        +addCustomerToGroup(pair) id
        +removeCustomerFromGroup(pair) void
        +createCustomerAddresses(data) CustomerAddressDTO
        +updateCustomerAddresses(id, data) CustomerAddressDTO
        +deleteCustomerAddresses(ids) void
    }

    Customer "1" --> "0..*" CustomerAddress : has
    Customer "0..*" --> "0..*" CustomerGroup : belongs to
    CustomerGroupCustomer --> Customer : customer_id
    CustomerGroupCustomer --> CustomerGroup : customer_group_id
    CustomerModuleService ..> Customer : manages
    CustomerModuleService ..> CustomerGroup : manages
    CustomerModuleService ..> CustomerAddress : manages
    CustomerModuleService ..> CustomerGroupCustomer : manages
